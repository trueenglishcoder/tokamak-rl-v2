#!/bin/bash
#SBATCH --job-name=tokamak-rl-v2-tcvj-actgen
#SBATCH --partition=batch
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:8
#SBATCH --cpus-per-task=16
#SBATCH --output=slurm_logs/tokamak-rl-v2-tcvj-actuator-generated-8gpu-100m-%j.out
#SBATCH --error=slurm_logs/tokamak-rl-v2-tcvj-actuator-generated-8gpu-100m-%j.err

set -euo pipefail

cd /scratch/$USER/tokamak/tokamak-rl-v2
mkdir -p slurm_logs outputs

# This launch path is intentionally one-to-one with the successful old
# trim50 replay-window/oracle trainer. The only training input we replace is
# the reset/target oracle library, which is generated by actuator-space
# coil-motion sampling and then simulated through tokamak-sim.
OLD_GOOD_SOURCE_CONFIG=configs/experiments/t15_new_trim50_plain_gpu1e6_replay_window_0p1s_tcvjdot_mpo_balanced.yaml
export SOURCE_CONFIG=${SOURCE_CONFIG:-${OLD_GOOD_SOURCE_CONFIG}}
export TRIM_MACHINE_CONFIG_SOURCE=${TRIM_MACHINE_CONFIG_SOURCE:-../tokamak-sim/configs/T15MD_new_data.toml}
export TRIM_DATA_ROOT=${TRIM_DATA_ROOT:-../tokamak-sim/data/t15_data_new_trim50}

export OBSERVED_RESET_LIBRARY=${OBSERVED_RESET_LIBRARY:-data/processed/t15_new_trim50_plain_gpu1e6_replay_window_0p1s_oracle_initial_states.npz}
export OBSERVED_TARGET_DIR=${OBSERVED_TARGET_DIR:-data/processed/t15_new_trim50_plain_gpu1e6_replay_window_0p1s_oracle_targets}
export OBSERVED_TARGETS=${OBSERVED_TARGETS:-${OBSERVED_TARGET_DIR}/t15_replay_window_oracle_targets.npz}
export OBSERVED_MACHINE_CONFIG=${OBSERVED_MACHINE_CONFIG:-data/processed/t15_new_trim50_plain_gpu1e6_machine_config.toml}
export OBSERVED_CONFIG_OUT=${OBSERVED_CONFIG_OUT:-data/processed/t15_new_trim50_plain_gpu1e6_replay_window_0p1s_oracle_config.yaml}

export BUILDER_SCRIPT=${BUILDER_SCRIPT:-scripts/build_t15_actuator_generated_trim50_plain_gpu1e6_0p1s.py}
export GENERATED_TARGET_DIR=${GENERATED_TARGET_DIR:-data/processed/t15_actuator_generated_trim50_plain_gpu1e6_0p1s}
export RESET_LIBRARY=${RESET_LIBRARY:-data/processed/t15_actuator_generated_trim50_plain_gpu1e6_0p1s_initial_states.npz}
export ORACLE_TARGET_DIR=${ORACLE_TARGET_DIR:-${GENERATED_TARGET_DIR}}
export ORACLE_TARGETS=${ORACLE_TARGETS:-${ORACLE_TARGET_DIR}/t15_replay_window_oracle_targets.npz}
export DIAGNOSTIC_TARGETS=${DIAGNOSTIC_TARGETS:-${GENERATED_TARGET_DIR}/t15_actuator_generated_targets.npz}

export CONFIG_NAME=${CONFIG_NAME:-t15_actuator_generated_trim50_plain_gpu1e6_oracle_window_0p1s_tcvjdot_balanced_8gpu_100m}
export RUN_NAME=${RUN_NAME:-t15_actuator_generated_trim50_plain_gpu1e6_oracle_window_0p1s_tcvjdot_balanced_8gpu_100m_${SLURM_JOB_ID:-manual}}
export TRAIN_OUTPUT=${TRAIN_OUTPUT:-outputs/${RUN_NAME}}
export GENERATED_CONFIG=${GENERATED_CONFIG:-${TRAIN_OUTPUT}/generated_configs/${RUN_NAME}.json}
export WANDB_PROJECT_NAME=${WANDB_PROJECT_NAME:-tokamak-rl-v2-tcvjdot-actuator-generated-oracle-8gpu-100m-${SLURM_JOB_ID:-manual}}

if [[ ! -f "${SOURCE_CONFIG}" ]]; then
  echo "missing old-good source config: ${SOURCE_CONFIG}" >&2
  exit 2
fi
if [[ "${SOURCE_CONFIG}" != "${OLD_GOOD_SOURCE_CONFIG}" ]]; then
  echo "this launch path must use the old-good source config exactly: ${OLD_GOOD_SOURCE_CONFIG}" >&2
  echo "got SOURCE_CONFIG=${SOURCE_CONFIG}" >&2
  exit 2
fi
if [[ ! -f "${BUILDER_SCRIPT}" ]]; then
  echo "missing actuator-generated target builder: ${BUILDER_SCRIPT}" >&2
  exit 2
fi
if [[ ! -d "${TRIM_DATA_ROOT}/ip" || ! -d "${TRIM_DATA_ROOT}/coils" ]]; then
  echo "missing trim50 data root: ${TRIM_DATA_ROOT}" >&2
  exit 2
fi
if [[ ! -f "${TRIM_MACHINE_CONFIG_SOURCE}" ]]; then
  echo "missing trim50 machine config source: ${TRIM_MACHINE_CONFIG_SOURCE}" >&2
  exit 2
fi

if [[ ! -f "${OBSERVED_RESET_LIBRARY}" || ! -f "${OBSERVED_TARGETS}" || ! -d "${OBSERVED_TARGET_DIR}" || ! -f "${OBSERVED_MACHINE_CONFIG}" ]]; then
  echo "observed real trim50 oracle libraries/config are missing; building them inside the container"
  srun \
    --ntasks=1 \
    --container-image /scratch/$USER/tokamak/tokamak-rl-v2.sqsh \
    --container-mounts /scratch/$USER/tokamak:/workspace,/dev:/dev,/lib/x86_64-linux-gnu:/host-libs \
    bash -lc '
      set -euo pipefail
      mkdir -p /tmp/nvidia-lib
      ln -sf /host-libs/libcuda.so.1 /tmp/nvidia-lib/libcuda.so.1
      ln -sf /tmp/nvidia-lib/libcuda.so.1 /tmp/nvidia-lib/libcuda.so
      ln -sf /host-libs/libnvidia-ml.so.1 /tmp/nvidia-lib/libnvidia-ml.so.1
      ln -sf /tmp/nvidia-lib/libnvidia-ml.so.1 /tmp/nvidia-lib/libnvidia-ml.so
      export LD_LIBRARY_PATH=/tmp/nvidia-lib:${LD_LIBRARY_PATH:-}
      export PYTHONPATH=/workspace/tokamak-sim:/workspace/tokamak-rl-v2:${PYTHONPATH:-}
      cd /workspace/tokamak-rl-v2

      python3 scripts/write_trim50_plain_gpu1e6_machine_config.py \
        --source "${TRIM_MACHINE_CONFIG_SOURCE}" \
        --out "${OBSERVED_MACHINE_CONFIG}"

      python3 scripts/build_t15_new_replay_window_oracle_targets.py \
        --base-config "${SOURCE_CONFIG}" \
        --data-root "${TRIM_DATA_ROOT}" \
        --machine-config "${OBSERVED_MACHINE_CONFIG}" \
        --target-dir "${OBSERVED_TARGET_DIR}" \
        --initial-library-out "${OBSERVED_RESET_LIBRARY}" \
        --config-out "${OBSERVED_CONFIG_OUT}" \
        --compute-backend gpu \
        --gpu-device cuda:0 \
        --batch-size 256 \
        --window-steps 100 \
        --angles 32 \
        --train-shots 3856 3857 3858 3863 \
        --holdout-shots 3864
    '
fi

for path in "${OBSERVED_RESET_LIBRARY}" "${OBSERVED_TARGETS}" "${OBSERVED_MACHINE_CONFIG}"; do
  if [[ ! -f "${path}" ]]; then
    echo "missing observed trim50 prerequisite after build: ${path}" >&2
    exit 2
  fi
done

if [[ ! -f "${RESET_LIBRARY}" || ! -f "${ORACLE_TARGETS}" || ! -f "${DIAGNOSTIC_TARGETS}" ]]; then
  if [[ "${ALLOW_BUILD_ACTUATOR_DATASET:-0}" != "1" ]]; then
    echo "missing prebuilt actuator-generated replay-window/oracle dataset." >&2
    echo "Run and inspect this first:" >&2
    echo "  sbatch jobs/build_t15_actuator_generated_trim50_plain_gpu1e6_0p1s_1gpu.sbatch" >&2
    echo "Expected artifacts:" >&2
    echo "  ${RESET_LIBRARY}" >&2
    echo "  ${ORACLE_TARGETS}" >&2
    echo "  ${DIAGNOSTIC_TARGETS}" >&2
    echo "Set ALLOW_BUILD_ACTUATOR_DATASET=1 only for manual debugging." >&2
    exit 2
  fi
  echo "ALLOW_BUILD_ACTUATOR_DATASET=1: building actuator-generated replay-window/oracle libraries inside the training job"
  srun \
    --ntasks=1 \
    --container-image /scratch/$USER/tokamak/tokamak-rl-v2.sqsh \
    --container-mounts /scratch/$USER/tokamak:/workspace,/dev:/dev,/lib/x86_64-linux-gnu:/host-libs \
    bash -lc '
      set -euo pipefail
      mkdir -p /tmp/nvidia-lib
      ln -sf /host-libs/libcuda.so.1 /tmp/nvidia-lib/libcuda.so.1
      ln -sf /tmp/nvidia-lib/libcuda.so.1 /tmp/nvidia-lib/libcuda.so
      ln -sf /host-libs/libnvidia-ml.so.1 /tmp/nvidia-lib/libnvidia-ml.so.1
      ln -sf /tmp/nvidia-lib/libnvidia-ml.so.1 /tmp/nvidia-lib/libnvidia-ml.so
      export LD_LIBRARY_PATH=/tmp/nvidia-lib:${LD_LIBRARY_PATH:-}
      export PYTHONPATH=/workspace/tokamak-sim:/workspace/tokamak-rl-v2:${PYTHONPATH:-}
      cd /workspace/tokamak-rl-v2

      python3 "${BUILDER_SCRIPT}" \
        --data-root "${TRIM_DATA_ROOT}" \
        --machine-config "${OBSERVED_MACHINE_CONFIG}" \
        --observed-targets "${OBSERVED_TARGETS}" \
        --out-dir "${GENERATED_TARGET_DIR}" \
        --initial-states-out "${RESET_LIBRARY}" \
        --targets-out "${ORACLE_TARGETS}" \
        --diagnostic-targets-out "${DIAGNOSTIC_TARGETS}" \
        --target-count "${ACTUATOR_TARGET_COUNT:-12000}" \
        --batch-size "${ACTUATOR_BUILD_BATCH_SIZE:-256}" \
        --gpu-device cuda:0 \
        --plots
    '
fi

for path in "${RESET_LIBRARY}" "${ORACLE_TARGETS}" "${DIAGNOSTIC_TARGETS}"; do
  if [[ ! -f "${path}" ]]; then
    echo "missing actuator-generated artifact after build: ${path}" >&2
    exit 2
  fi
done

if [[ -z "${HOLDOUT_EVAL_EPISODES:-}" ]]; then
  HOLDOUT_EVAL_EPISODES=$(
    srun \
      --ntasks=1 \
      --container-image /scratch/$USER/tokamak/tokamak-rl-v2.sqsh \
      --container-mounts /scratch/$USER/tokamak:/workspace \
      bash -lc '
        set -euo pipefail
        cd /workspace/tokamak-rl-v2
        python3 scripts/count_npz_string_value.py "${RESET_LIBRARY}" --array split --value holdout
      '
  )
  export HOLDOUT_EVAL_EPISODES
fi

srun \
  --ntasks=1 \
  --container-image /scratch/$USER/tokamak/tokamak-rl-v2.sqsh \
  --container-mounts /scratch/$USER/tokamak:/workspace,/dev:/dev,/lib/x86_64-linux-gnu:/host-libs \
  bash -lc '
    set -euo pipefail
    export PYTHONPATH=/workspace/tokamak-sim:/workspace/tokamak-rl-v2:${PYTHONPATH:-}
    cd /workspace/tokamak-rl-v2
    python3 - <<PY
import json
import numpy as np
from pathlib import Path

source = json.loads(Path("${SOURCE_CONFIG}").read_text(encoding="utf-8"))
if source["reference"]["ip"]["kind"] != "replay_window":
    raise SystemExit("source config is not the old-good replay_window Ip config")
if source["reference"]["boundary"]["kind"] != "t15_replay_segment_conditioned":
    raise SystemExit("source config is not the old-good replay-window boundary config")
if float(source["reward"].get("mean_jdot_bias_weight", 0.0)) != 0.0:
    raise SystemExit("old-good source config unexpectedly enables mean_jdot_bias_weight")

with np.load("${ORACLE_TARGETS}", allow_pickle=False) as data:
    required = {"shot_id", "source_index", "time_s", "ip_target", "boundary_radii", "real_jdot_action", "difficulty_bin"}
    missing = sorted(required - set(data.files))
    if missing:
        raise SystemExit("actuator-generated oracle target is missing arrays: " + ", ".join(missing))
    if data["ip_target"].shape[1] != 101:
        raise SystemExit(f"expected ip_target shape [N,101], got {data['ip_target'].shape}")
    if data["boundary_radii"].shape[1:] != (101, 32):
        raise SystemExit(f"expected boundary_radii shape [N,101,32], got {data['boundary_radii'].shape}")
    if data["real_jdot_action"].shape[1:] != (100, 9):
        raise SystemExit(f"expected real_jdot_action shape [N,100,9], got {data['real_jdot_action'].shape}")
    if float(np.max(np.abs(data["real_jdot_action"]))) > 1.0001:
        raise SystemExit("actuator-generated oracle contains normalized Jdot actions outside [-1,1]")
    print("actuator_generated_oracle_rows", int(data["ip_target"].shape[0]))

with np.load("${RESET_LIBRARY}", allow_pickle=False) as data:
    required = {"shot_id", "source_index", "time_s", "ip0", "pfc0", "sol0", "split", "difficulty_bin"}
    missing = sorted(required - set(data.files))
    if missing:
        raise SystemExit("actuator-generated reset library is missing arrays: " + ", ".join(missing))
    split = data["split"].astype(str)
    print("actuator_generated_reset_rows", int(split.shape[0]), "holdout", int((split == "holdout").sum()))
PY
  '

echo "delegating to old-good replay-window/oracle trainer"
echo "RUN_NAME=${RUN_NAME}"
echo "HOLDOUT_EVAL_EPISODES=${HOLDOUT_EVAL_EPISODES}"
echo "RESET_LIBRARY=${RESET_LIBRARY}"
echo "ORACLE_TARGET_DIR=${ORACLE_TARGET_DIR}"

bash jobs/train_t15_new_trim50_plain_gpu1e6_replay_window_0p1s_tcvjdot_balanced_oracle_8gpu_100m.sbatch
